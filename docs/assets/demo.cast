[0.0, "o", "\u001b[1;36m## 10. Secrets: sealed value in Git, decrypted only inside the cluster\u001b[0m\r\n"]
[1.019, "o", "\u001b[32m$\u001b[0m printf '%s' 'demo-value' | scripts/seal-secret.sh dev API_KEY\r\n"]
